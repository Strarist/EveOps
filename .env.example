DATABASE_URL="postgresql://eveops:eveops@localhost:55432/eveops?schema=public"
REDIS_URL="redis://localhost:6379"
# Must be >= 32 chars and different from OTP_ENCRYPTION_SECRET
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Required in every environment; never reuse SESSION_SECRET
OTP_ENCRYPTION_SECRET="replace-with-a-different-32-character-secret"
API_URL="http://localhost:4000/api"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
WEB_ORIGIN="http://localhost:3000"
COOKIE_SECURE="false"
MAX_EXPORT_ROWS="50000"
# Local placeholder. A production process treats this value as omitted and uses
# RENDER_GIT_COMMIT, or reports "unlabeled" when no release id was supplied.
BUILD_SHA="development"
