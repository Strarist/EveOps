{
  "name": "@eveops/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build -w @eveops/contracts && npm run build -w @eveops/operations",
    "build": "nest build",
    "prestart": "npm run build -w @eveops/contracts && npm run build -w @eveops/operations",
    "start": "node dist/main",
    "prestart:dev": "npm run build -w @eveops/contracts && npm run build -w @eveops/operations",
    "start:dev": "nest start --watch",
    "lint": "eslint src",
    "test": "jest --runInBand",
    "test:regression": "jest --runInBand --testPathPatterns regression.volume.spec",
    "db:fixture:regression": "jest --runInBand --testPathPatterns regression.fixture.seed.spec --forceExit"
  },
  "dependencies": {
    "@eveops/contracts": "*",
    "@eveops/operations": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
